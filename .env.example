# The Manager — sample environment overrides.
# Copy to `.env.local` to apply locally. All entries are optional.

# Where on-disk state lives. Default: ~/.the-manager/
# THE_MANAGER_HOME=

# Path to the CLI binaries. Defaults to looking them up on PATH.
# THE_MANAGER_CLAUDE_BIN=/Users/you/.local/bin/claude
# THE_MANAGER_CODEX_BIN=
# THE_MANAGER_GEMINI_BIN=

# URL the Electron window loads in dev. Default: http://localhost:3000
# THE_MANAGER_DEV_URL=
