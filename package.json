{
  "name": "the-manager",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.4.0+sha512.f0febc7e37552ab485494a914241b338e0b3580b93d54ce31f00933015880863129038a1b4ae4e414a0ee63ac35bf21197e990172c4a68256450b5636310968f",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=@the-manager/web",
    "dev:desktop": "turbo run dev --parallel --filter=@the-manager/desktop --filter=@the-manager/web",
    "build": "turbo run build",
    "start": "turbo run start --filter=@the-manager/web",
    "dmg": "pnpm --filter @the-manager/desktop dmg",
    "dist": "pnpm --filter @the-manager/desktop dist",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "smoke": "node scripts/smoke-api.mjs",
    "smoke:persistence": "tsx packages/persistence/scripts/smoke.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "turbo": "^2.9.0",
    "typescript": "^5.7.0"
  }
}
